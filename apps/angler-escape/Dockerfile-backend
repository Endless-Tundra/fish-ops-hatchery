# ---- Stage 1: Build & Compile ----
FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json ./

RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY server.ts tsconfig.json config.ts ./

RUN npx esbuild server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/server.js

RUN npm prune --omit=dev && rm -rf /root/.npm

# ---- Stage 2: Ultra-Secure Production Runtime ----
FROM gcr.io/distroless/nodejs24-debian13 AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy the unbundled files and clean production modules over
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY package.json ./

EXPOSE 3000

CMD ["dist/server.js"]
