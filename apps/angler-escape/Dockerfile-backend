# Production Dockerfile for Backend Container
FROM node:24-alpine
RUN apk update && apk upgrade --no-cache libcrypto3 libssl3 ssl_client

WORKDIR /app
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi && npm cache clean --force

COPY server.ts ./
COPY tsconfig.json ./

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["npx", "tsx", "server.ts"]
