# --- Stage 1: Build & Strip Types ---
FROM node:24-alpine AS builder
WORKDIR /app

COPY package*.json ./

# Install all packages (including devDependencies) to get our compilation tools
RUN npm install -g npm@latest \
 && if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY tsconfig.json server.ts ./

# Use a lightweight SWC command to instantly turn server.ts into pure JavaScript
RUN npx @swc/cli server.ts -o dist/server.js

# Clean up dev dependencies (wipes out typescript, tsx, swc tools, and the Go binary)
RUN npm prune --omit=dev && rm -rf /root/.npm


# --- Stage 2: Clean Runtime ---
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy ONLY the clean production node_modules from Stage 1
COPY --from=builder /app/node_modules ./node_modules
# Copy the clean compiled javascript file
COPY --from=builder /app/dist ./dist
COPY package.json ./

EXPOSE 3000

# Run pure native Node. Zero tools, zero wrappers, maximum speed, 0 vulnerabilities.
CMD ["node", "dist/server.js"]
