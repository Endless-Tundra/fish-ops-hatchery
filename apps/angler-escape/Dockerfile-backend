# Production Dockerfile for Backend Container
FROM node:24-alpine

WORKDIR /app
COPY package*.json ./
RUN npm install -g npm@latest
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi && npm cache clean --force


COPY server.ts ./
COPY tsconfig.json ./

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["npx", "tsx", "server.ts"]
